{
  "schemaVersion": 3,
  "id": "tiktools.remote-control",
  "name": "Remote Control",
  "version": "1.0.0",
  "publisher": "tiktools",
  "license": "MIT",
  "engines": {
    "tiktools": ">=4.2.3, <5.0.0"
  },
  "repository": "https://github.com/nglmercer/plugins-example-tiktools",
  "description": "Remote control gateway owned by the user, with host-mediated command execution.",
  "longDescription": "Runs its own listener and dispatches received commands through the host's capability-gated host.call API. Never receives a bearer token or ControlApi.",
  "icon": "network",
  "tags": [
    "remote",
    "control"
  ],
  "runtime": "process",
  "trust": "trusted",
  "entry": "tiktools-remote-control-plugin",
  "protocolVersion": 1,
  "capabilities": [
    "events.subscribe",
    "events.publish",
    "host.call"
  ],
  "eventSubscriptions": [
    "cloud.login.code",
    "*"
  ],
  "actionTypes": [
    {
      "id": "tiktools.remote-control.test",
      "version": 1,
      "title": {
        "default": "Test remote control"
      },
      "description": {
        "default": "Checks the host call channel."
      },
      "requiredCapabilities": [
        "host.call"
      ]
    },
    {
      "id": "tiktools.remote-control.status",
      "version": 1,
      "title": {
        "default": "Remote control status"
      },
      "description": {
        "default": "Reports the Cloud state and this PC's relay link."
      },
      "requiredCapabilities": [
        "host.call"
      ]
    },
    {
      "id": "tiktools.remote-control.host.start",
      "version": 1,
      "title": {
        "default": "Start this PC's link"
      },
      "description": {
        "default": "Starts this PC's outbound relay link for its team."
      },
      "requiredCapabilities": [
        "host.call"
      ]
    },
    {
      "id": "tiktools.remote-control.host.stop",
      "version": 1,
      "title": {
        "default": "Stop this PC's link"
      },
      "description": {
        "default": "Stops this PC's outbound relay link."
      },
      "requiredCapabilities": [
        "host.call"
      ]
    },
    {
      "id": "tiktools.remote-control.teams.list",
      "version": 1,
      "title": {
        "default": "List teams"
      },
      "description": {
        "default": "Lists the remote-control teams of the signed-in account."
      },
      "requiredCapabilities": [
        "host.call"
      ]
    },
    {
      "id": "tiktools.remote-control.team.create",
      "version": 1,
      "title": {
        "default": "Create team"
      },
      "description": {
        "default": "Creates a remote-control team owned by the signed-in account."
      },
      "requiredCapabilities": [
        "host.call"
      ]
    },
    {
      "id": "tiktools.remote-control.device.enroll",
      "version": 1,
      "title": {
        "default": "Enroll this PC"
      },
      "description": {
        "default": "Enrolls this PC as a controller or as a team host."
      },
      "requiredCapabilities": [
        "host.call"
      ]
    },
    {
      "id": "tiktools.remote-control.invitation.create",
      "version": 1,
      "title": {
        "default": "Create invitation"
      },
      "description": {
        "default": "Creates a single-use invitation for a team; the token is shown once."
      },
      "requiredCapabilities": [
        "host.call"
      ]
    },
    {
      "id": "tiktools.remote-control.requests.list",
      "version": 1,
      "title": {
        "default": "List requests"
      },
      "description": {
        "default": "Lists join requests of a team."
      },
      "requiredCapabilities": [
        "host.call"
      ]
    },
    {
      "id": "tiktools.remote-control.requests.decide",
      "version": 1,
      "title": {
        "default": "Decide a request"
      },
      "description": {
        "default": "Approves or denies a join request."
      },
      "requiredCapabilities": [
        "host.call"
      ]
    },
    {
      "id": "tiktools.remote-control.grants.list",
      "version": 1,
      "title": {
        "default": "List access grants"
      },
      "description": {
        "default": "Lists the access grants of a team."
      },
      "requiredCapabilities": [
        "host.call"
      ]
    },
    {
      "id": "tiktools.remote-control.pairings.list",
      "version": 1,
      "title": {
        "default": "List sessions"
      },
      "description": {
        "default": "Lists the controller sessions of a team."
      },
      "requiredCapabilities": [
        "host.call"
      ]
    },
    {
      "id": "tiktools.remote-control.grants.revoke",
      "version": 1,
      "title": {
        "default": "Revoke access"
      },
      "description": {
        "default": "Revokes one access grant; the host records the owner audit."
      },
      "requiredCapabilities": [
        "host.call"
      ]
    },
    {
      "id": "tiktools.remote-control.command.run",
      "version": 1,
      "title": {
        "default": "Run a read command"
      },
      "description": {
        "default": "Sends one read command to a team through the relay and returns the host's answer."
      },
      "requiredCapabilities": [
        "host.call"
      ]
    }
  ],
  "cliCommands": [
    {
      "id": "test",
      "actionType": "tiktools.remote-control.test",
      "description": "Test the remote-control host call channel (dry run unless --live)"
    },
    {
      "id": "status",
      "actionType": "tiktools.remote-control.status",
      "description": "Show remote control status (dry run unless --live)"
    }
  ],
  "ui": {
    "apiVersion": 1,
    "mode": "webview",
    "entry": "ui/dist/index.html",
    "pages": [
      {
        "id": "remote",
        "title": {
          "default": "Remote control"
        },
        "icon": "network"
      }
    ]
  },
  "pages": [
    {
      "id": "remote",
      "title": {
        "default": "Remote control"
      },
      "icon": "network",
      "sections": [
        {
          "kind": "text",
          "text": {
            "default": "Manage this PC's team access and run controller tests in the Remote control page."
          }
        }
      ]
    }
  ]
}
